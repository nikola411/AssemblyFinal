Terminals unused in grammar

    ASCII
    "("
    ")"
    ":"


Grammar

    0 $accept: NT_Program "end of file"

    1 NT_Program: NT_Program NT_Line
    2           | NT_Line
    3           | "end of file"

    4 NT_Line: NT_Directive
    5        | NT_ProcessorInstruction
    6        | NT_BranchInstruction
    7        | NT_StackInstruction
    8        | NT_DataInstruction
    9        | NT_MemoryInstruction
   10        | NT_SpecialInstruction
   11        | NT_LabelAndComment

   12 NT_LabelAndComment: COMMENT
   13                   | LABEL

   14 NT_Directive: NT_DirectiveWithSymbolList
   15             | NT_DirectiveWithList
   16             | NT_DirectiveSingleArgument
   17             | NT_DirectiveWithArithmeticAssignment
   18             | END

   19 NT_DirectiveWithList: WORD NT_LiteralList
   20                     | WORD NT_SymbolList

   21 NT_DirectiveSingleArgument: SECTION SYMBOL
   22                           | SKIP LITERAL

   23 NT_DirectiveWithSymbolList: NT_DirectiveIdentifier NT_SymbolList

   24 NT_DirectiveWithArithmeticAssignment: EQU SYMBOL "," NT_ArithmeticExpression

   25 NT_DirectiveIdentifier: GLOBAL
   26                       | EXTERN

   27 NT_ProcessorInstruction: HALT
   28                        | INT
   29                        | IRET
   30                        | RET

   31 NT_BranchInstruction: NT_ConditionalJumpIdentifier NT_ConditionalJumpOperands
   32                     | NT_UnconditionalJumpIdentifier NT_JumpOperand

   33 NT_ConditionalJumpIdentifier: BEQ
   34                             | BNE
   35                             | BGT

   36 NT_ConditionalJumpOperands: "%" GPR "," "%" GPR "," NT_JumpOperand

   37 NT_UnconditionalJumpIdentifier: JMP
   38                               | CALL

   39 NT_DataInstruction: NT_DataInstructionIdentifier NT_DataInstructionOperands

   40 NT_DataInstructionIdentifier: XCHG
   41                             | ADD
   42                             | SUB
   43                             | MUL
   44                             | DIV
   45                             | NOT
   46                             | AND
   47                             | OR
   48                             | XOR
   49                             | SHL
   50                             | SHR

   51 NT_DataInstructionOperands: "%" GPR "," "%" GPR
   52                           | "%" GPR

   53 NT_MemoryInstruction: LD NT_Operand "," "%" GPR
   54                     | ST "%" GPR "," NT_Operand

   55 NT_SpecialInstruction: CSRRD "%" CSR "," "%" GPR
   56                      | CSRWR "%" GPR "," "%" CSR

   57 NT_StackInstruction: NT_StackInstructionIdentifier "%" GPR

   58 NT_StackInstructionIdentifier: PUSH
   59                              | POP

   60 NT_SymbolList: NT_SymbolList "," SYMBOL
   61              | SYMBOL

   62 NT_LiteralList: NT_LiteralList "," LITERAL
   63               | LITERAL

   64 NT_ArithmeticExpression: NT_MultiplicativeExpression
   65                        | NT_ArithmeticExpression "+" NT_MultiplicativeExpression
   66                        | NT_ArithmeticExpression "-" NT_MultiplicativeExpression

   67 NT_MultiplicativeExpression: NT_MultiplicativeExpression "*" LITERAL
   68                            | NT_MultiplicativeExpression "/" LITERAL
   69                            | LITERAL

   70 NT_JumpOperand: SYMBOL
   71               | LITERAL

   72 NT_Operand: "$" LITERAL
   73           | "$" SYMBOL
   74           | LITERAL
   75           | SYMBOL
   76           | "%" GPR
   77           | "[" "%" GPR "]"
   78           | "[" "%" GPR "+" LITERAL "]"
   79           | "[" "%" GPR "+" SYMBOL "]"


